{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "publicURL": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+\\.ts\\.net$"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["google", "proxy"]},
        "trustedProxyCIDRs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "trustedHeader": {"type": "string", "minLength": 1},
        "displayNameHeader": {"type": "string"},
        "pictureHeader": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "proxyNamespace": {"type": "string", "minLength": 1}
      }
    },
    "tailscale": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        }
      }
    }
  }
}
