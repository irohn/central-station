# ---- Runtime ----
APP_ENV=development            # development | production
ADDR=:8080                     # API listen address (inside the container)
# With docker compose the browser reaches the API through the web container,
# so both public URLs are the web origin. Set to your real hostname in production.
BASE_URL=http://localhost:3000 # Public URL of the API (used for the OAuth redirect URL)
FRONTEND_URL=http://localhost:3000  # Web app origin (CORS + post-login redirect)
WEB_PORT=3000                  # host port for the web app
API_PORT=8080                  # host port for direct API access (curl/debugging)

# ---- Database ----
# docker compose builds DATABASE_URL from these for the bundled Postgres.
POSTGRES_USER=central
POSTGRES_PASSWORD=central
POSTGRES_DB=central
# Running the API outside compose: set the URL directly. Empty = in-memory (dev only).
# DATABASE_URL=postgres://central:central@localhost:5432/central?sslmode=disable

# ---- Sessions ----
# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=168h               # 7 days
COOKIE_SECURE=false            # set true when served over HTTPS

# ---- Google SSO (OAuth 2.0 / OpenID Connect) ----
# Create at https://console.cloud.google.com/apis/credentials (Web application).
# Authorised redirect URI must be: ${BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to ${BASE_URL}/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=

# ---- Email + password sign-in (feature flag) ----
# Works alongside Google SSO, or alone (e.g. a deployment without Google).
AUTH_PASSWORD_ENABLED=false
# New accounts start as AUTH_UNVERIFIED_ROLE and become AUTH_VERIFIED_ROLE once
# the address is verified: by email link when SMTP is configured, otherwise by
# an admin on the Users page. ADMIN_EMAILS only take effect once verified.
AUTH_UNVERIFIED_ROLE=listener
AUTH_VERIFIED_ROLE=collaborator
# Optional SMTP for verification email (STARTTLS on 587, implicit TLS on 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Access control ----
# Sign-in allow-list: domains and/or specific addresses, comma-separated.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# Whether the allow-list is enforced. Unset = enforced only when a list above is
# non-empty. Set false to keep the lists on file but let any Google account in
# (e.g. while the app is only reachable on a private network), true to enforce
# (e.g. before exposing it to the internet). ADMIN_EMAILS are always allowed.
ACCESS_ALLOWLIST=
# Comma-separated emails that are granted the admin role on sign-in.
ADMIN_EMAILS=
# Role assigned to brand-new users: listener | collaborator | manager | admin
DEFAULT_ROLE=listener
# Optional: replace the permissions a role level introduces (roles stay
# cumulative; admins always hold everything). Comma-separated. Defaults:
# ROLE_PERMISSIONS_LISTENER=queue:read,history:read,track:resolve
# ROLE_PERMISSIONS_COLLABORATOR=queue:add,queue:remove_own,playlist:write,volume:control
# ROLE_PERMISSIONS_MANAGER=queue:remove_any,queue:reorder,playback:control,fallback:manage,playlist:remove_any,broadcast:send,alerts:manage
# ROLE_PERMISSIONS_ADMIN=settings:manage,users:manage,integrations:manage

# ---- Providers ----
DEFAULT_PROVIDER=youtube
# Optional. With a key the YouTube Data API v3 is used (accurate metadata, durations).
# Without it the API falls back to scraping the results page + oEmbed (no key needed).
YOUTUBE_API_KEY=

# ---- Default playlist ----
# Plays whenever the queue is empty. Seeds the setting on first start only;
# managers/admins change it afterwards from the UI (gear menu -> Default playlist).
FALLBACK_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLFgquLnL59alCl_2TQvOiD5Vgm1hCaGSI
FALLBACK_SHUFFLE=true

# ---- Player (headless speaker container) ----
# Shared secret between the api and player containers. Generate: openssl rand -hex 24
PLAYER_TOKEN=
PLAYER_NAME=office-player
# Host audio socket mounted into the player. WSL2 (WSLg) default shown;
# Linux desktop: /run/user/1000/pulse/native (PulseAudio or PipeWire).
PULSE_SOCKET=/mnt/wslg/PulseServer
# macOS (Docker Desktop): sockets cannot be mounted. Instead run PulseAudio on the
# Mac (./scripts/mac-audio.sh) and enable the TCP override with:
# COMPOSE_FILE=docker-compose.yml:docker-compose.mac.yml
MPV_AO=pulse                   # pulse | alsa (with /dev/snd passed through)

# ---- Announcements ----
# Text-to-speech service for typed announcements (tts/ in this repo). docker
# compose starts it as "tts"; leave empty to offer recordings only.
TTS_URL=http://tts:5000
# Storage guard rails (defaults shown). Worst case ≈ CLIPS_MAX_SAVED × CLIPS_MAX_BYTES
# in Postgres (250 MB); a typical clip is well under 1 MB. Bundled chimes do not count.
CLIPS_MAX_SAVED=50
CLIPS_MAX_BYTES=5242880
CLIPS_MAX_DURATION_SECONDS=60
TTS_MAX_CHARS=600

# ---- Alerts (scheduled announcements) ----
# Default IANA timezone for new alerts (each alert can override it).
ALERTS_TIMEZONE=Asia/Jerusalem

# ---- Local development only ----
# Enables POST /api/v1/auth/dev/login so you can get a session without Google.
# Refused when APP_ENV=production.
AUTH_DEV_MODE=false
